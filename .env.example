# Copy this file to .env and fill in the values (.env is not committed).
#
# Vite reads these at build time and inlines them into the browser bundle,
# so they are public configuration, not secrets. Set the same variables in
# your hosting or CI settings for production builds; `npm run dev` and
# `npm run build` stop with an error if a required one is missing.

# Backend REST API (with the trailing slash)
VITE_API_BASE_URL=https://api.example.com/api/v1/

# Server that hosts restock-request photos (no trailing slash)
VITE_UPLOADS_BASE_URL=https://api.example.com:3000

# Google Maps JavaScript + Geocoding API browser key.
# Restrict it to your domains in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase web app (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Google Analytics for Firebase
VITE_FIREBASE_MEASUREMENT_ID=
